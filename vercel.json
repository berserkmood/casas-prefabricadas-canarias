{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "casasprefabricadascanarias.es"}],
      "destination": "https://www.casasprefabricadascanarias.es/:path*",
      "permanent": true
    },
    {
      "source": "/guias/normativa-permisos-casas-prefabricadas-canarias",
      "destination": "/guias/permisos-casa-prefabricada-canarias",
      "permanent": true
    },
    {
      "source": "/guias/materiales-segun-clima-canarias",
      "destination": "/guias/materiales-casa-prefabricada-canarias",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/guias/:path*/",
      "destination": "/guias/index.html"
    },
    {
      "source": "/guias/:path*",
      "destination": "/guias/:path*.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.webp|.*\\.png|.*\\.jpg|.*\\.ico|.*\\.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.css|.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
